# Copy to /opt/script-audit-mcp/etc/script-audit-mcp.env, chmod 0640,
# chown root:script-audit, then fill in the real password.
# This file is read by systemd; it must stay outside the repository.

# Shared PostgreSQL function catalog on the SAME Ubuntu host (SELECT-only login).
# Plaintext database traffic is restricted to loopback; do not use this option
# for a remote database. This is independent of the public MCP HTTP transport.
SCRIPT_AUDIT_DATABASE_URL='postgresql://script_forge@127.0.0.1:5432/program_functions?sslmode=disable'

# If PostgreSQL requires TLS, replace the URL above with a certificate-matching
# hostname and verified TLS. Do not change PostgreSQL's existing security policy.
# SCRIPT_AUDIT_DATABASE_URL='postgresql://script_forge@catalog.example.internal:5432/program_functions?sslmode=verify-full'

# Database password; kept out of the URL.
PGPASSWORD='replace-with-real-password'

# Optional private PEM CA bundle for sslmode=verify-full.
# PGSSLROOTCERT=/opt/script-audit-mcp/etc/ca.pem
