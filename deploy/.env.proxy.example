# Build-time proxy settings for cargo (optional).
#
# Kept apart from the service environment file on purpose: these values are
# loaded only into the build.sh process (also when update.sh runs it) so cargo
# can download crates. The running service and smoke checks never see them.
#
# Usage on the Ubuntu host:
#   install -m 600 deploy/.env.proxy.example deploy/.env.proxy
#   edit deploy/.env.proxy privately with the approved proxy URL
#   ./deploy/update.sh
#
# build.sh loads this trusted shell file automatically. Keep mode 600 and never
# commit the real file. Percent-encode special characters in the user name or
# password (for example $ -> %24, @ -> %40, % -> %25).
# When this file exists, it replaces inherited HTTP(S)/NO_PROXY settings.
# Comment out or delete a line to omit that setting from this profile.
# Without this file, exported shell proxy settings continue to work.
http_proxy='replace_me'
https_proxy='replace_me'
no_proxy='127.0.0.1,localhost,::1,10.176.2.139'
